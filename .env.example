# ============================================================
# SIH26056 — Real-Time Airfare CPI — Environment Configuration
# ============================================================
# Variables marked [ACTIVE] are read by the code. Variables marked [PLANNED] are
# reserved for functionality that is not implemented yet and currently have no
# effect — they are kept as documentation of the intended design, not as working
# switches. See AUDIT.md.

# ── Scraper / data source ──
# [ACTIVE] mock | live
#   mock → observations come from the calibrated fare simulator; every API response
#          and report is tagged data_provenance="synthetic".
#   live → observations come from real collection; tagged "live".
# No real scrapers exist yet, so 'live' currently yields no data. See AUDIT.md §4.
SCRAPER_MODE=mock

# ── Index computation ──
# [ACTIVE] Reference base period for the Jevons elementary aggregates.
INDEX_BASE_PERIOD_START=2026-08-01
INDEX_BASE_PERIOD_DAYS=7

# [ACTIVE] Advance-purchase horizons collected, in days before departure.
# NOTE: observations across these horizons are currently POOLED into a single route
# index rather than stratified. See AUDIT.md M2.
BOOKING_HORIZONS=0,3,7,15,30

# ── API ──
# [ACTIVE] Comma-separated allowed browser origins. Never set this to "*" for a
# deployment that handles credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# [ACTIVE] Shared secret for state-mutating endpoints (POST /api/v1/scraper/trigger).
# Leave empty for a local demo. REQUIRED for any internet-reachable deployment,
# otherwise anyone can mutate the published index.
ADMIN_API_TOKEN=

# ── Frontend ──
# [ACTIVE] Base URL of the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# [ACTIVE] Optional server-side proxy for the AI Copilot.
# The Copilot falls back to a local deterministic knowledge base when unset.
# ⚠️ Never put a provider API key in a NEXT_PUBLIC_* variable: Next.js inlines those
# into the client bundle, making them public. The key belongs in the proxy's own
# server-side environment only.
NEXT_PUBLIC_COPILOT_PROXY_URL=

# ============================================================
# PLANNED — no effect yet
# ============================================================

# [PLANNED] The API stores data in memory only; nothing connects to PostgreSQL yet,
# although docker-compose does start a fully-seeded database. See AUDIT.md Q1.
# Use a strong password for anything beyond local development.
DATABASE_URL=postgresql+asyncpg://airfare:airfare@localhost:5432/airfare_cpi
DATABASE_URL_SYNC=postgresql://airfare:airfare@localhost:5432/airfare_cpi
POSTGRES_USER=airfare
POSTGRES_PASSWORD=change_me_before_any_shared_deployment
POSTGRES_DB=airfare_cpi

# [PLANNED] No scheduler is wired up; backend/scraper/scheduler.py is not imported
# by any module and uses a fixed interval rather than these IST windows.
SCRAPER_SCHEDULE_HOURS=10,18
SCRAPER_HEADLESS=true
SCRAPER_RATE_LIMIT_SECONDS=5
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_MS=30000

# [PLANNED] API host/port are currently passed on the uvicorn command line.
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
