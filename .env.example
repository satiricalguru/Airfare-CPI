# ============================================================
# SIH26056 — Real-Time Airfare CPI — Environment Configuration
# ============================================================

# Database
DATABASE_URL=postgresql+asyncpg://airfare:airfare@localhost:5432/airfare_cpi
DATABASE_URL_SYNC=postgresql://airfare:airfare@localhost:5432/airfare_cpi
POSTGRES_USER=airfare
POSTGRES_PASSWORD=airfare
POSTGRES_DB=airfare_cpi

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Scraper
SCRAPER_MODE=mock  # mock | live | hybrid
SCRAPER_HEADLESS=true
SCRAPER_SCHEDULE_HOURS=10,18  # IST hours for scraping runs
SCRAPER_RATE_LIMIT_SECONDS=5  # Delay between requests
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_MS=30000

# Index Computation
INDEX_BASE_PERIOD_START=2026-08-01
INDEX_BASE_PERIOD_END=2026-08-31
BOOKING_HORIZONS=0,3,7,15,30

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
