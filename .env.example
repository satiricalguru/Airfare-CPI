# SIH26056 — Airfare Price Intelligence environment
# Copy to .env and supply real secrets locally. Never commit credentials.

# Collection mode: LIVE is the operational mode. SIMULATED is opt-in and must be
# used only for methodology demonstrations. A failed live source never falls back.
COLLECTION_MODE=LIVE
ENABLED_SOURCES=amadeus
BOOKING_HORIZONS=1,7,15,30,45
COLLECTION_PASSENGERS=1
COLLECTION_CABIN=ECONOMY

# Active live source. The test environment returns real availability from the
# Amadeus Self-Service inventory but has quota/catalogue limitations.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test
AMADEUS_TIMEOUT_SECONDS=20
AMADEUS_MIN_REQUEST_INTERVAL=0.25
AMADEUS_MAX_OFFERS=40

# Bounded, polite collection behaviour.
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_BACKOFF_BASE=2
SCRAPER_RETRY_BACKOFF_MAX=30
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MIN_REQUEST_INTERVAL=1
SCRAPER_MAX_CONCURRENCY=4

# Scheduled collection windows in Asia/Kolkata local time.
SCHEDULER_ENABLED=false
SCHEDULER_COLLECTION_HOURS=10,18
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_MAX_CYCLE_SECONDS=3600
SCHEDULER_TICK_SECONDS=60

# Index and validation policy.
# Set this once to the first day of a clean verified live collection window; do not
# move it forward on each restart. This example begins on the current project epoch.
INDEX_BASE_PERIOD_START=2026-09-03
INDEX_BASE_PERIOD_DAYS=7
INDEX_MIN_MATCHED_PRODUCTS=3
VALIDATION_MIN_FARE=500
VALIDATION_MAX_FARE=80000
VALIDATION_MAX_DAILY_CHANGE_PCT=300
VALIDATION_IQR_MULTIPLIER=3

# Persistent store. SQLite is the zero-setup default in code; Docker Compose
# supplies its PostgreSQL URL to the API container.
DATABASE_URL=sqlite+aiosqlite:///backend/airfare_cpi_managed.db
POSTGRES_USER=airfare
POSTGRES_PASSWORD=change_me_before_any_shared_deployment
POSTGRES_DB=airfare_cpi
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
# Never enable for a shared database. Docker uses Alembic before starting the API;
# this is only for isolated local/test databases where all contents may be discarded.
DB_AUTO_CREATE_SCHEMA=false

# Public read API and protected mutation API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Required: all state-changing endpoints return 503 while this is empty.
ADMIN_API_TOKEN=
# Per-process limits for external-cost / state-changing operations. Deploy an
# equivalent ingress-level policy when running more than one API worker.
API_COPILOT_RATE_LIMIT=20
API_COPILOT_RATE_WINDOW_SECONDS=600
API_MUTATION_RATE_LIMIT=6
API_MUTATION_RATE_WINDOW_SECONDS=60

# Browser-visible backend URL. Never put service credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional server-side Copilot provider configuration.
COPILOT_API_KEY=
# Set an explicit model that is available to your provider account. With either value
# empty, the endpoint uses its labelled deterministic local fallback.
COPILOT_MODEL=
